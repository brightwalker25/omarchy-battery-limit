#!/usr/bin/env python3
"""Read and set the battery charge threshold, for the brightwalker25.battery-limit
bar panel and for use from a terminal.

Design notes:

- All of the decisions are made here and the panel only renders them. Which
  limit is in force, whether a travel override is still running, whether the
  firmware accepted what it was given, and whether the machine is configured
  to hold the limit across a reboot are all determined in this script and
  published as JSON. The QML therefore contains no policy, and every answer
  the panel displays can be reproduced at the command line.
- Nothing here runs as root. The only privileged operation is writing to
  charge_control_end_threshold, and the installer makes that unprivileged once
  by granting the wheel group access to the attribute through a udev rule.
  Until the installer has been run, `set` fails and reports the command to
  run, rather than raising a password prompt in a bar panel where there is
  nowhere to type one.
- The requested limit and the effective limit are reported separately, because
  firmware is free to round a request to its own steps. Every write is read
  back afterwards, and the value that is displayed is the value read back.
- The standing limit and the travel override are kept in a configuration file
  rather than in this process, because the systemd units that reapply the
  limit at boot and after resume run as root, long after any panel has exited.
  That file is the interface between the two halves, and it holds nothing but
  integers.

Exit status is 0 when the requested operation succeeded and 1 when it did not.
`status` succeeds even on a machine with no controllable battery, where the
answer is reported in the JSON.
"""
import argparse
import errno
import json
import os
import re
import sys
import time

CONF = "/etc/omarchy-battery-limit.conf"
APPLY_HELPER = "/usr/local/lib/omarchy-battery-limit/apply"
POWER_SUPPLY = "/sys/class/power_supply"
LIMIT_ATTR = "charge_control_end_threshold"
START_ATTR = "charge_control_start_threshold"

# Below this a cap stops preserving the battery and starts producing a laptop
# that runs out as soon as it is unplugged. The firmware would accept a lower
# value, but this tool does not offer one.
MIN_LIMIT = 40
MAX_LIMIT = 100

# How far below the end threshold a start threshold is lowered when a driver
# refuses to accept the two at the same value. Charging then resumes five
# points below the cap instead of at it, which avoids the charger switching on
# and off repeatedly around a single point.
START_GAP = 5

DURATION = re.compile(r"^(\d+)\s*([hdwm])?$", re.I)


# --------------------------------------------------------------- sysfs reading

def read_attr(path):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return None


def read_int(path):
    raw = read_attr(path)
    if raw is None:
        return None
    try:
        return int(raw)
    except ValueError:
        return None


def find_batteries():
    """Every battery that exposes an end threshold, in kernel name order.

    The name of the node is not assumed to be BAT0, or even to begin with BAT,
    because that varies between drivers. A machine may also carry more than
    one pack, in which case each of them is capped, so that the limit does not
    depend on which pack the panel happened to look at first.
    """
    found = []
    if not os.path.isdir(POWER_SUPPLY):
        return found
    for name in sorted(os.listdir(POWER_SUPPLY)):
        path = os.path.join(POWER_SUPPLY, name)
        if not os.path.exists(os.path.join(path, LIMIT_ATTR)):
            continue
        if (read_attr(os.path.join(path, "type")) or "") != "Battery":
            continue
        found.append(path)
    return found


def find_battery():
    """The first battery that exposes an end threshold, or None.

    The readings shown in the bar and the panel come from this one. On the
    ordinary machine with a single pack it is the only candidate.
    """
    batteries = find_batteries()
    return batteries[0] if batteries else None


def health(path):
    """Capacity now against capacity when new, as a percentage.

    Batteries report either energy (uWh) or charge (uAh) depending on the
    driver. Both are read because a machine that reports one will not report
    the other, and a health figure is worth more than consistency of units.
    """
    for now, design in (("energy_full", "energy_full_design"),
                        ("charge_full", "charge_full_design")):
        full = read_int(os.path.join(path, now))
        new = read_int(os.path.join(path, design))
        if full and new:
            return round(full * 100.0 / new, 1)
    return None


# --------------------------------------------------------------- config file

def read_conf():
    """Parse the configuration file, accepting integers and nothing else.

    The file is group-writable so that the panel can change the limit without
    a password, and it is read at boot by a helper running as root. Anything
    that is not a plain integer is discarded rather than interpreted, so that
    write access to the file cannot be turned into anything more than the
    ability to choose a charge limit.
    """
    conf = {"limit": None, "travel_limit": None, "travel_until": None}
    try:
        with open(CONF) as fh:
            text = fh.read()
    except OSError:
        return conf
    for key, field in (("LIMIT", "limit"),
                       ("TRAVEL_LIMIT", "travel_limit"),
                       ("TRAVEL_UNTIL", "travel_until")):
        m = re.search(r"^%s=(\d*)$" % key, text, re.M)
        if m and m.group(1):
            conf[field] = int(m.group(1))
    return conf


def write_conf(conf):
    body = (
        "# Written by battery-limit. Values are integers; anything else is\n"
        "# ignored by the root helper that reads this file at boot and on\n"
        "# resume. Edit by hand if you like, or use `battery-limit set`.\n"
        "#\n"
        "# LIMIT         the standing charge cap, in percent\n"
        "# TRAVEL_LIMIT  a temporary cap that overrides it, empty when unused\n"
        "# TRAVEL_UNTIL  epoch seconds the override expires, empty for never\n"
        "LIMIT=%s\n"
        "TRAVEL_LIMIT=%s\n"
        "TRAVEL_UNTIL=%s\n"
    ) % (
        "" if conf["limit"] is None else conf["limit"],
        "" if conf["travel_limit"] is None else conf["travel_limit"],
        "" if conf["travel_until"] is None else conf["travel_until"],
    )
    # The file is written in place, into the existing inode, rather than by
    # writing a temporary file and renaming it over the original. The rename
    # approach would require permission to create and unlink files in /etc,
    # which this process does not have and should not be granted, since the
    # privilege being granted here is one group-writable file rather than a
    # writable /etc. Opening the file with "r+" also preserves the root:wheel
    # ownership and the 664 mode that the installer applied, neither of which
    # a newly created file would inherit.
    #
    # The cost of that choice is that the write is not atomic. It is a single
    # short buffer written in one call, and the reader accepts only complete
    # lines of digits and applies nothing when it finds none, so an interrupted
    # write loses the setting rather than corrupting it.
    with open(CONF, "r+") as fh:
        fh.write(body)
        fh.truncate()
    return True


def effective_limit(conf, now=None):
    """Which of the two configured limits is in force, and why.

    A travel override with no expiry remains in force until it is cleared by
    hand, and one whose expiry has passed is no longer in force. This is the
    only place where that comparison is made, so no caller needs to examine
    the clock itself.
    """
    now = time.time() if now is None else now
    if conf["travel_limit"] is not None:
        if conf["travel_until"] is None or now < conf["travel_until"]:
            return conf["travel_limit"], "travel"
    return conf["limit"], "standing"


# --------------------------------------------------------------- installation

def setup_state(battery):
    """Which parts of the system integration are present, as three facts.

    They are reported separately because they can fail separately. The
    attribute may be writable while the systemd units are absent, which
    describes a machine that will accept a new limit now and forget it at the
    next reboot. Combining the three into a single boolean would conceal that.
    """
    attr = os.path.join(battery, LIMIT_ATTR) if battery else None
    return {
        "writable": bool(attr and os.access(attr, os.W_OK)),
        "configWritable": os.access(CONF, os.W_OK),
        "persists": os.path.exists(APPLY_HELPER),
    }


# --------------------------------------------------------------- the snapshot

def snapshot():
    batteries = find_batteries()
    battery = batteries[0] if batteries else None
    conf = read_conf()
    limit, source = effective_limit(conf)
    setup = setup_state(battery)

    rep = {
        "generatedAt": int(time.time()),
        "battery": os.path.basename(battery) if battery else "",
        "batteries": [],
        "supported": battery is not None,
        "hardwareLimit": None,
        "startThreshold": None,
        "charge": None,
        "status": "",
        "healthPercent": None,
        "cycleCount": None,
        "configuredLimit": conf["limit"],
        "travelLimit": conf["travel_limit"],
        "travelUntil": conf["travel_until"],
        "effectiveLimit": limit,
        "effectiveSource": source,
        "minimum": MIN_LIMIT,
        "maximum": MAX_LIMIT,
        "setup": setup,
        "warnings": [],
    }

    if not battery:
        rep["warnings"].append(
            "No battery on this machine exposes a charge threshold. On an "
            "ASUS laptop that usually means the asus_nb_wmi module is not "
            "loaded. On other hardware it usually means the kernel driver "
            "does not support a charge threshold at all.")
        return rep

    # Each pack is listed, because a machine with a second battery has a
    # threshold on each of them and they can be set to different values by
    # something other than this tool.
    rep["batteries"] = [
        {"name": os.path.basename(path),
         "hardwareLimit": read_int(os.path.join(path, LIMIT_ATTR)),
         "startThreshold": read_int(os.path.join(path, START_ATTR))}
        for path in batteries
    ]

    rep["hardwareLimit"] = read_int(os.path.join(battery, LIMIT_ATTR))
    rep["startThreshold"] = read_int(os.path.join(battery, START_ATTR))
    rep["charge"] = read_int(os.path.join(battery, "capacity"))
    rep["status"] = read_attr(os.path.join(battery, "status")) or ""
    rep["healthPercent"] = health(battery)
    rep["cycleCount"] = read_int(os.path.join(battery, "cycle_count"))

    # The firmware is the authority on what the limit actually is. A config
    # file that disagrees with it is describing an intention, not a state, and
    # the difference is exactly what goes wrong when a reboot drops the cap.
    caps = set(b["hardwareLimit"] for b in rep["batteries"]
               if b["hardwareLimit"] is not None)
    if len(caps) > 1:
        rep["warnings"].append(
            "The batteries on this machine are capped at different values: %s. "
            "Run `battery-limit apply` to set them all to the configured limit."
            % ", ".join("%s at %d%%" % (b["name"], b["hardwareLimit"])
                        for b in rep["batteries"]
                        if b["hardwareLimit"] is not None))

    if limit is not None and rep["hardwareLimit"] is not None \
            and limit != rep["hardwareLimit"]:
        rep["warnings"].append(
            "The battery is capped at %d%% but %d%% is configured. Run "
            "`battery-limit apply` to put the configured limit back."
            % (rep["hardwareLimit"], limit))

    if not setup["writable"]:
        rep["warnings"].append(
            "The charge threshold is not writable by you. Run the installer "
            "once with sudo to grant it: see INSTALL.md.")
    elif not setup["persists"]:
        rep["warnings"].append(
            "The limit can be changed but will not survive a reboot. Run the "
            "installer once with sudo to make it stick.")

    return rep


# --------------------------------------------------------------- the actions

def write_attr(path, value):
    """Write an integer to a sysfs attribute, returning the error if it fails."""
    try:
        with open(path, "w") as fh:
            fh.write("%d\n" % value)
    except OSError as exc:
        return exc
    return None


def set_battery_limit(battery, value):
    """Set the end threshold on one battery and report what the firmware kept.

    The value is read back after the write because firmware is permitted to
    round a request to its own steps, and a caller that trusted its own
    request would display a limit the machine is not applying.

    Some drivers, thinkpad_acpi among them, reject an end threshold that is
    below the current start threshold, which is the point at which charging
    resumes. Where that happens the start threshold is lowered out of the way
    and the write is attempted once more. It is only touched when the driver
    has already refused the write, so on hardware that does not impose the
    restriction the setting is left exactly as the firmware had it.
    """
    attr = os.path.join(battery, LIMIT_ATTR)
    start_attr = os.path.join(battery, START_ATTR)

    err = write_attr(attr, value)
    if err is None:
        return read_int(attr), None

    if getattr(err, "errno", None) == errno.EINVAL:
        start = read_int(start_attr)
        if start is not None and start >= value:
            lowered = max(0, value - START_GAP)
            start_err = write_attr(start_attr, lowered)
            if start_err is not None:
                return None, (
                    "This driver will not accept a limit of %d%% while "
                    "charging is set to resume at %d%%, and %s could not be "
                    "lowered to %d%%: %s"
                    % (value, start, start_attr, lowered, start_err))
            err = write_attr(attr, value)
            if err is None:
                return read_int(attr), None

    if getattr(err, "errno", None) == errno.EACCES:
        return None, (
            "Not permitted to write %s. Run the installer once with sudo to "
            "grant your account access: see INSTALL.md." % attr)
    return None, "Could not write %s: %s" % (attr, err)


def apply_limit(value):
    """Set the end threshold on every battery, and report the first result.

    A machine with a second pack exposes a threshold on each of them, and the
    root helper that runs at boot writes to all of them. This does the same,
    so that the limit the panel shows and the limit the machine holds after a
    reboot describe the same hardware.
    """
    batteries = find_batteries()
    if not batteries:
        return None, "No battery on this machine exposes a charge threshold."

    effective = None
    failures = []
    for battery in batteries:
        got, err = set_battery_limit(battery, value)
        if err is not None:
            failures.append("%s: %s" % (os.path.basename(battery), err))
        elif effective is None:
            effective = got

    if effective is None:
        return None, "\n".join(failures)
    for failure in failures:
        warn("The limit was set, but one battery did not accept it. " + failure)
    return effective, None


def parse_duration(text):
    """Turn `24h`, `3d`, `2w` or `off` into an expiry, or None for indefinite."""
    text = str(text).strip().lower()
    if text in ("off", "never", "forever", "indefinite"):
        return None
    m = DURATION.match(text)
    if not m:
        raise ValueError(
            "Cannot read '%s' as a duration. Use 24h, 3d, 2w, or off." % text)
    n = int(m.group(1))
    unit = (m.group(2) or "h").lower()
    seconds = {"m": 60, "h": 3600, "d": 86400, "w": 604800}[unit]
    return int(time.time()) + n * seconds


def cmd_set(args):
    value = args.value
    if value < MIN_LIMIT or value > MAX_LIMIT:
        fail("A limit of %d%% is outside the %d to %d range this tool allows."
             % (value, MIN_LIMIT, MAX_LIMIT))

    conf = read_conf()
    travel = args.duration is not None

    if travel:
        try:
            conf["travel_until"] = parse_duration(args.duration)
        except ValueError as exc:
            fail(str(exc))
        conf["travel_limit"] = value
        # A standing limit must exist for the override to expire back to. On
        # a first run there may not be one yet, and reverting to no limit at
        # all would mean reverting to 100%.
        if conf["limit"] is None:
            conf["limit"] = 80
    else:
        # Setting the limit outright is also how a travel override is left,
        # rather than providing a second command that does the same thing.
        conf["limit"] = value
        conf["travel_limit"] = None
        conf["travel_until"] = None

    effective, err = apply_limit(value)
    if err:
        fail(err)

    try:
        write_conf(conf)
    except OSError:
        warn("The limit was set, but %s could not be written, so it will not "
             "survive a reboot. Run the installer once with sudo." % CONF)

    return effective


def cmd_apply(_args):
    """Put the configured limit back, retiring a travel override that has run out.

    This is the command the boot, resume and timer units call. It is
    idempotent, and it does nothing at all when no limit has been configured,
    so that a machine without a configuration file is left as the firmware
    left it.
    """
    conf = read_conf()
    limit, source = effective_limit(conf)

    if conf["travel_limit"] is not None and source != "travel":
        conf["travel_limit"] = None
        conf["travel_until"] = None
        try:
            write_conf(conf)
        except OSError:
            pass
        limit, source = effective_limit(conf)

    if limit is None:
        return None
    effective, err = apply_limit(limit)
    if err:
        fail(err)
    return effective


def cmd_clear_travel(_args):
    conf = read_conf()
    if conf["travel_limit"] is None:
        return None
    conf["travel_limit"] = None
    conf["travel_until"] = None
    try:
        write_conf(conf)
    except OSError:
        warn("Could not write %s." % CONF)
    if conf["limit"] is None:
        return None
    effective, err = apply_limit(conf["limit"])
    if err:
        fail(err)
    return effective


# --------------------------------------------------------------- presentation

def fmt_expiry(ts):
    if ts is None:
        return "until you change it"
    left = ts - time.time()
    if left <= 0:
        return "expired"
    if left < 3600:
        return "for another %d minutes" % round(left / 60)
    if left < 86400 * 2:
        return "for another %d hours" % round(left / 3600)
    return "for another %d days" % round(left / 86400)


def as_text(rep):
    out = []
    if not rep["supported"]:
        out.append("Charge limit: not supported on this machine")
    else:
        limit = rep["effectiveLimit"]
        hw = rep["hardwareLimit"]
        line = "Charge limit: %s%%" % (hw if hw is not None else "unknown")
        if rep["effectiveSource"] == "travel":
            line += " (travel, %s)" % fmt_expiry(rep["travelUntil"])
            if rep["configuredLimit"] is not None:
                line += ", then back to %d%%" % rep["configuredLimit"]
        elif limit is None:
            line += " (nothing configured)"
        out.append(line)
        out.append("Battery %s: %s%%, %s" % (
            rep["battery"],
            rep["charge"] if rep["charge"] is not None else "?",
            rep["status"].lower() or "unknown"))
        health_line = "Health: "
        health_line += ("%s%%" % rep["healthPercent"]) \
            if rep["healthPercent"] is not None else "unknown"
        if rep["cycleCount"] is not None:
            health_line += ", %d cycles" % rep["cycleCount"]
        out.append(health_line)
        setup = rep["setup"]
        out.append("Setup: %s, %s" % (
            "settable without sudo" if setup["writable"] else "NOT settable",
            "survives reboot" if setup["persists"] else "does NOT survive reboot"))
    for w in rep["warnings"]:
        out.append("! " + w)
    return "\n".join(out)


def warn(msg):
    sys.stderr.write(msg + "\n")


def fail(msg):
    sys.stderr.write(msg + "\n")
    sys.exit(1)


# --------------------------------------------------------------- entry point

def main():
    # The output flags are accepted on either side of the subcommand, since
    # `battery-limit apply --text` is a natural order in which to type them.
    # SUPPRESS is what allows that: the copies of the flag held by each
    # subparser leave the attribute unset unless the flag was actually given,
    # so a flag passed before the subcommand is not overwritten by the
    # subparser's own default.
    #
    # The default is read back with getattr rather than declared through
    # set_defaults, because `parents=` shares a single Action object with
    # every parser that lists it, and set_defaults would write through that
    # shared object and undo the SUPPRESS this depends on.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--text", action="store_true",
                        default=argparse.SUPPRESS,
                        help="human-readable output instead of JSON")
    common.add_argument("--pretty", action="store_true",
                        default=argparse.SUPPRESS, help="indent the JSON")

    p = argparse.ArgumentParser(
        prog="battery-limit", parents=[common],
        description="Read and set the battery charge limit.")
    sub = p.add_subparsers(dest="command")

    sub.add_parser("status", parents=[common],
                   help="report the limit, charge and health (default)")

    s = sub.add_parser("set", parents=[common], help="set the charge limit")
    s.add_argument("value", type=int, metavar="PERCENT")
    s.add_argument("--for", dest="duration", metavar="DURATION", default=None,
                   help="make it a travel override that expires: 24h, 3d, 2w, "
                        "or off for one that does not expire")

    sub.add_parser("apply", parents=[common],
                   help="reapply the configured limit, retiring an expired "
                        "travel override")
    sub.add_parser("clear-travel", parents=[common],
                   help="drop a travel override and return to the standing limit")

    args = p.parse_args()
    command = args.command or "status"

    if command == "set":
        cmd_set(args)
    elif command == "apply":
        cmd_apply(args)
    elif command == "clear-travel":
        cmd_clear_travel(args)

    rep = snapshot()
    if getattr(args, "text", False):
        print(as_text(rep))
    else:
        print(json.dumps(rep, indent=2 if getattr(args, "pretty", False) else None))
    return 0


if __name__ == "__main__":
    sys.exit(main())
